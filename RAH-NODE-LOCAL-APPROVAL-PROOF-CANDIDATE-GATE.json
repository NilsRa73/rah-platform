  },
  "authoritySurface": {
    "capabilities": ["compute", "storage", "display", "remote-desktop"],
    "actions": ["storage-summary.read", "rustdesk.launch", "rustdesk.connect"],
    "routes": ["/health", "/actions", "/storage", "/launch/rustdesk", "/handoff/rustdesk"]
  },
  "protocolGrammar": {
    "catalogRoute": "/actions",
    "catalogMethod": "GET",
    "approvalActionHeader": "X-RAH-Approval-Action",
    "approvalTargetHeader": "X-RAH-Approval-Target",
    "approvalProofHeader": "X-RAH-Local-Approval",
    "actionChallengeHeader": "X-RAH-Action-Challenge",
    "approvalActionAllowedValues": ["rustdesk.launch", "rustdesk.connect"],
    "launchTargetHeaderRule": "must-be-absent",
    "connectTargetHeaderRule": "required-and-must-pass-existing-peer-id-validator",
    "catalogWithoutApprovalIntent": "may-advertise-fixed-actions; must-not-issue-mutating-local-approval-proof",
    "approvalIntentWithInvalidHeaderShape": "fail-closed-before-local-prompt",
    "approvalIntentWithValidHeaderShape": "requires-local-node-confirmation-before-mutating-challenge-proof-pair-is-returned",
    "actionRequest": "existing-fixed-action-route-plus-current-bearer-token-plus-action-challenge; mutating-action-adds-X-RAH-Local-Approval",
    "genericHeadersOrBodyArguments": false,
    "newRoute": false
  },
  "mutatingProofPolicy": {
    "requiredFor": ["rustdesk.launch", "rustdesk.connect"],
    "notRequiredFor": ["storage-summary.read"],
    "additionalToExistingGates": true,
    "proofTtlSeconds": 30,
    "challengeTtlSeconds": 30,
    "proofRandomBitsMinimum": 192,
    "challengeAndProofDistinct": true,
    "singleUse": true,
    "atomicPairConsumption": true,
    "boundTo": ["fixed-action-id", "node-agent-session-id", "canonical-action-input-digest", "paired-challenge"],
    "maxPendingLocalConfirmations": 1,
    "maxActiveUnusedPairs": 1,
    "newSuccessfulConfirmationInvalidatesOlderUnusedPair": true,
    "proofStorage": "process-memory-only",
    "challengeStorage": "process-memory-only",
    "rawPeerIdProofState": "forbidden",
    "connectProofState": "sha256-canonical-peer-id-digest-only"
  },
  "consoleCoordinator": {
    "interactiveConsoleRequiredForMutatingProof": true,
    "headlessBehavior": "fail-closed-for-mutating-proof-intent",
    "networkThreadReadsStdin": false,
    "dedicatedLocalCoordinatorOwnsStdin": true,
    "pendingQueueCapacity": 1,
    "networkWaitSeconds": 30,
    "promptCooldownSecondsMinimum": 2,
    "promptContent": "fixed-action-label-plus-strictly-validated-peer-id-for-connect-only",
    "attackerFreeTextInPrompt": false,
    "approvalInput": "local-y-or-n-only",
    "remoteFallback": false
  },
  "executionRequirementsMutating": [
    "fixed-action",
    "advertised-action",
    "required-capability",
    "cc-ephemeral-local-approval",
    "current-process-bearer-token",
    "agent-session-match",
    "exact-policy-id",
    "node-local-human-confirmation",
    "fresh-action-bound-single-use-challenge",
    "fresh-node-local-single-use-approval-proof",
    "proof-challenge-action-session-input-digest-pair-match"
  ],
