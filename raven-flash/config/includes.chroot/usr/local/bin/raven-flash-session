#!/bin/sh
# The window manager owns the login session; closing Chromium must not log out.
set -eu
export XDG_CURRENT_DESKTOP=RavenFlash
export XDG_SESSION_DESKTOP=raven-flash
export BROWSER=/usr/local/bin/raven-flash-browser
umask 077
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/raven-flash"
if command -v nm-applet >/dev/null 2>&1; then nm-applet >/dev/null 2>&1 & fi
if command -v tint2 >/dev/null 2>&1; then tint2 >/dev/null 2>&1 & fi
/usr/local/bin/raven-flash-browser >"${XDG_STATE_HOME:-$HOME/.local/state}/raven-flash/browser.log" 2>&1 &
exec openbox --sm-disable --config-file /opt/raven-flash/openbox-rc.xml

