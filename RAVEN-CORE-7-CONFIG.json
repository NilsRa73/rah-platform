    "rah": "C:\\RAH",
    "core": "C:\\RAH\\RavenCore7",
    "ravenOs": "C:\\RAH\\RavenOS",
    "hardwareRegistry": "C:\\RAH\\HardwareRegistry",
    "aiFabric": "C:\\RAH\\AI-Fabric"
  },
  "ports": {
    "ravenCore": 18765,
    "nodeAgent": 18766,
