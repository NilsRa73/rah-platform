{
  "product": "RAH Raven Care Hub",
  "version": "0.6.0-candidate",
  "stage": "candidate",
  "released_from_stable": "0.5.0",
  "released_at": "2026-08-17",
  "entry": "RAH-RAVEN-CARE-HUB-V0.6-CANDIDATE.html",
  "runtime_feature_change": true,
  "stable_runtime_modified": false,
  "authority_delta": "none",
  "scope": "explicit local Care handoff with Health & Fatigue CSV summary",
  "integration": {
    "case_center": {
      "stable_version": "1.6.0",
      "health_url": "http://127.0.0.1:18765/health",
      "explicit_refresh_only": true,
      "allowed_network_paths": ["/health"],
      "case_extract_allowed": false,
      "case_analyze_allowed": false,
      "capture_allowed": false,
      "lm_calls_allowed": false
    },
    "fristvakt": {
      "stable_version": "0.2.0",
      "import_mode": "explicit-user-selected-json",
      "required_product": "RAH Raven Fristvakt",
      "required_schema_version": 1,
      "session_memory_only": true,
      "automatic_persistence": false,
      "browser_storage": false
    },
    "health_fatigue": {
      "stable_version": "0.2.0",
      "import_mode": "explicit-user-selected-csv",
      "exact_csv_fields": [
        "date",
        "fatigue",
        "functionLevel",
        "sleepHours",
        "sleepQuality",
        "restingPulse",
        "glucose",
        "hba1c",
        "activityMinutes",
        "delayedWorsening",
        "medicationNote",
        "sideEffectNote",
        "note"
      ],
      "max_file_bytes": 2097152,
      "max_rows": 2000,
      "session_memory_only": true,
      "raw_rows_retained_after_summary": false,
      "snapshot_contains_raw_health_rows": false,
      "automatic_persistence": false,
      "browser_storage": false
    }
  },
  "health_summary": {
    "descriptive_only": true,
    "fields": [
      "rowCount",
      "firstDate",
      "lastDate",
      "averageFatigue",
      "averageSleepHours",
      "averageActivityMinutes",
      "latestDate",
      "latestGlucose",
      "latestHba1c"
    ],
    "medical_thresholds": false,
    "diagnostic_inference": false,
    "treatment_recommendations": false,
    "dose_recommendations": false,
    "causality_claims": false,
    "alerts": false,
    "legal_health_cross_inference": false
  },
  "features": {
    "combined_work_dashboard": true,
    "source_labels_visible": true,
    "explicit_local_snapshot_export": true,
    "health_fatigue_explicit_csv_import": true,
    "health_fatigue_summary_only_export": true,
    "automatic_network_requests": false,
    "external_network_requests": false,
    "background_polling": false,
    "automatic_sending": false,
    "automatic_calling": false,
    "medical_decision_automation": false,
    "legal_decision_automation": false,
    "ai_execution": false,
    "file_upload_to_network": false,
    "microphone_capture": false,
    "camera_capture": false,
    "sensor_sync": false,
    "stable_care_hub_v0_5_modified": false,
    "stable_health_fatigue_v0_2_modified": false,
    "stable_case_center_v1_6_modified": false,
    "stable_fristvakt_v0_2_modified": false,
    "stable_fastlege_v0_3_modified": false,
    "stable_raven_runtime_modified": false,
    "command_center_node_authority_modified": false
  },
  "candidate_gate": {
