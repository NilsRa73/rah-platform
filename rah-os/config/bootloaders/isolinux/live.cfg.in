menu hshift 0
menu width 76
menu title RAH OS RAVEN // BOOT CONTROL
include stdmenu.cfg

label rah-standard-@FLAVOUR@
  menu label ^1 RAH OS // STANDARD
  menu default
  linux @LINUX@
  initrd @INITRD@
  append @APPEND_LIVE@ rah.profile=standard

label rah-nova-@FLAVOUR@
  menu label ^2 RAH NOVA VI // CONTROLLER MODE
  linux @LINUX@
  initrd @INITRD@
  append @APPEND_LIVE@ rah.profile=nova

label rah-rescue-@FLAVOUR@
  menu label ^3 RAH GHOST & RESCUE // TOOLS
  linux @LINUX@
  initrd @INITRD@
  append @APPEND_LIVE@ rah.profile=rescue

label rah-forge-@FLAVOUR@
  menu label ^4 RAH FORGE // AI + DEV + RAVEN
  linux @LINUX@
  initrd @INITRD@
  append @APPEND_LIVE@ rah.profile=forge

label rah-arcade-@FLAVOUR@
  menu label ^5 RAH ARCADE NEXUS // RETRO + MEDIA
  linux @LINUX@
  initrd @INITRD@
  append @APPEND_LIVE@ rah.profile=arcade

menu begin advanced
  menu title RAH SYSTEM TOOLS // INSTALL
  include stdmenu.cfg

  label rah-failsafe-@FLAVOUR@
    menu label RAH SAFE GRAPHICS // RECOVERY
    linux @LINUX@
    initrd @INITRD@
    append @APPEND_LIVE_FAILSAFE@ rah.profile=rescue

  label installgui
    menu label INSTALL RAH OS // GRAPHICAL SETUP
    linux /install/gtk/vmlinuz
    initrd /install/gtk/initrd.gz
    append video=vesa:ywrap,mtrr vga=788 @APPEND_INSTALL@ --- quiet

  label mainmenu
    menu label ^BACK TO RAH BOOT CONTROL
    menu exit
menu end
