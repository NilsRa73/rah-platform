#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'EOF'
RAH Ghost - local disk image / rescue wrapper

Usage:
  rah-ghost list
  rah-ghost create  /dev/SOURCE  /path/to/image.img
  rah-ghost verify  /path/to/image.img
  rah-ghost restore /path/to/image.img /dev/TARGET --erase-target
  rah-ghost --self-test

Safety:
  create reads a block device and writes an image file.
  restore ERASES the selected target block device and always requires both
  --erase-target and an interactive typed confirmation.
EOF
}

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1" >&2; exit 12; }
}

as_root() {
  if [[ ${EUID} -eq 0 ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

is_block() { [[ -b "$1" ]]; }

mounted_children() {
  lsblk -nrpo NAME,MOUNTPOINT "$1" 2>/dev/null | awk 'NF >= 2 && $2 != "" {print $1 " -> " $2}'
}

self_test() {
  local failed=0
  for cmd in lsblk findmnt ddrescue sha256sum blockdev awk sed sudo; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf '[PASS] %-12s %s\n' "$cmd" "$(command -v "$cmd")"
    else
      printf '[FAIL] %-12s missing\n' "$cmd"
      failed=1
    fi
  done
  [[ $failed -eq 0 ]] || exit 20
  echo "[PASS] RAH Ghost prerequisites are available. No disk was read or written."
}

cmd="${1:-}"
case "$cmd" in
  --help|-h|help|"") usage; exit 0 ;;
  --self-test) self_test; exit 0 ;;
  list)
    need lsblk
    lsblk -e 7 -o NAME,MODEL,SERIAL,SIZE,TYPE,FSTYPE,MOUNTPOINTS,RO,TRAN
    ;;
  create)
    need ddrescue; need sha256sum; need lsblk
    source_dev="${2:-}"; image="${3:-}"
    [[ -n "$source_dev" && -n "$image" ]] || { usage; exit 2; }
    is_block "$source_dev" || { echo "Source is not a block device: $source_dev" >&2; exit 3; }
    [[ ! -b "$image" ]] || { echo "Image destination must be a file, not a block device." >&2; exit 4; }
    mkdir -p "$(dirname "$image")"
    mapfile_path="${image}.map"
    echo "RAH Ghost CREATE: $source_dev -> $image"
    echo "Mounted source volumes are allowed for emergency imaging, but a quiescent/offline source is safer."
    as_root ddrescue -n -v "$source_dev" "$image" "$mapfile_path"
    sha256sum "$image" | tee "${image}.sha256"
    echo "CREATE complete. Map: $mapfile_path  Checksum: ${image}.sha256"
    ;;
  verify)
    need sha256sum
    image="${2:-}"
    [[ -f "$image" ]] || { echo "Image file not found: $image" >&2; exit 5; }
    if [[ -f "${image}.sha256" ]]; then
      (cd "$(dirname "$image")" && sha256sum -c "$(basename "${image}.sha256")")
    else
      sha256sum "$image"
    fi
    ;;
  restore)
    need ddrescue; need lsblk; need blockdev
    image="${2:-}"; target="${3:-}"; gate="${4:-}"
    [[ -f "$image" ]] || { echo "Image file not found: $image" >&2; exit 6; }
    is_block "$target" || { echo "Target is not a block device: $target" >&2; exit 7; }
    [[ "$gate" == "--erase-target" ]] || { echo "Restore refused: append --erase-target." >&2; exit 8; }
    mounts="$(mounted_children "$target" || true)"
    if [[ -n "$mounts" ]]; then
      echo "Restore refused: target or a child partition is mounted:" >&2
      echo "$mounts" >&2
      exit 9
    fi
    echo "DANGER: this will overwrite $target with $image"
    printf 'Type exactly: ERASE %s\n> ' "$target"
    read -r confirm
    [[ "$confirm" == "ERASE $target" ]] || { echo "Confirmation did not match. Nothing written."; exit 10; }
    mapfile_path="${image}.restore-$(basename "$target").map"
    as_root ddrescue -f -v "$image" "$target" "$mapfile_path"
    as_root sync
    echo "RESTORE complete. Map: $mapfile_path"
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 2
    ;;
esac
