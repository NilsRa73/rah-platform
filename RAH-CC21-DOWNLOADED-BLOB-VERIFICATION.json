{
  "schemaVersion": 1,
  "stage": "stable-updater-downloaded-blob-verification",
  "guardId": "rah-cc21-downloaded-git-blob-verification-v1",
  "authorityDelta": "none",
  "releaseCommit": "a6b77f93dca5f774cdb76deb707edc71f86638a1",
  "canonicalManifest": "RAH-COMMAND-CENTER-VERSION.json",
  "packageFileCount": 49,
  "treePolicy": {
    "commitTreeShaRequired": true,
    "recursiveTreeFetchedOnce": true,
    "truncatedTreeRejected": true,
    "requiredPackagePathsExactlyOnce": true,
    "canonicalManifestPathAlsoRequired": true,
    "requiredType": "blob",
    "requiredMode": "100644",
    "validObjectId": "40-lowercase-or-uppercase-hex",
    "symlinkMode120000Rejected": true,
    "submoduleMode160000Rejected": true
  },
  "downloadPolicy": {
    "rawDownloadBase": "verified-fixed-release-commit-only",
    "gitObjectVerification": "sha1-of-git-blob-header-plus-raw-bytes",
    "gitBlobHeader": "blob <byteLength>\\0",
    "verifyCanonicalManifestBeforeParsing": true,
    "verifyStableReleaseManifestBeforeParsing": true,
    "verifyEveryPackageDownloadBeforeLocalComparison": true,
    "verifyBeforeBackupOrReplacement": true,
    "mismatchBehavior": "fail-closed-with-current-installation-file-untouched",
    "sha1Role": "git-object-identity-bound-to-already-verified-commit-tree-not-standalone-trust"
  },
  "baseline": {
    "ravenVersion": "2.0.32",
    "commandCenterVersion": "2.1.0",
    "nodeAgentVersion": "1.3.0",
    "nodeActionsProtocol": "rah-node-actions-v7",
    "authProtocol": "rah-node-auth-v2",
    "policyId": "rah-capability-allowlist-v1"
  },
  "authoritySurface": {
    "capabilities": ["compute","storage","display","remote-desktop"],
    "actions": ["storage-summary.read","rustdesk.launch","rustdesk.connect"],
    "businessRoutes": ["/health","/actions","/storage","/launch/rustdesk","/handoff/rustdesk"]
  },
  "forbiddenFallbacks": [
    "branch-head-package-source",
    "unverified-release-commit",
    "commit-sha-mismatch-fallback",
    "tree-sha-missing-or-invalid",
    "truncated-tree-acceptance",
    "symlink-or-submodule-package-entry",
    "unverified-raw-package-byte-install",
    "package-path-outside-fixed-allowlist",
    "generic-command-process-action-file-api",
    "caller-controlled-executable-path-or-generic-arguments",
    "native-raven-remote-control-api",
    "network-token-renewal-endpoint",
    "bearer-token-lan-transport",
    "secret-persistence"
  ]
}
