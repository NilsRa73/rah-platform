{
  "schemaVersion": 1,
  "stage": "stable-updater-transactional-staging",
  "guardId": "rah-cc21-transactional-package-staging-v1",
  "authorityDelta": "none",
  "transaction": {
    "canonicalManifest": "RAH-COMMAND-CENTER-VERSION.json",
    "packageFileCount": 49,
    "activationFileCount": 50,
    "staging": "all-50-files-before-first-package-mutation",
    "stagingPath": "root-local-dot-rah-staging",
    "allStagedFilesGitBlobVerified": true,
    "stableReleaseContractValidatedFromStaging": true,
    "backupEveryExistingTargetBeforeActivation": true,
    "backupSha256VerifiedBeforeActivation": true,
    "recordOriginallyAbsentTargets": true,
    "activationUsesSame-directory-temporary-file": true,
    "activationTempGitBlobReverified": true,
    "canonicalManifestActivatedLast": true,
    "postActivationGitBlobVerification": true,
    "handledActivationFailure": "restore-all-original-files-and-remove-originally-absent-targets",
    "stagingCleanupOnExit": true,
    "successfulBackupRetention": true
  },
  "explicitLimit": {
    "powerLossAtomicity": false,
    "processKillAtomicity": false,
    "persistentTransactionJournal": false,
    "nextResearchBoundary": "persistent-journal-and-crash-recovery"
  },
  "retainedTrustChain": [
    "fixed-github-verified-release-commit",
    "exact-release-commit-sha-match",
    "exact-release-tree-sha",
    "non-truncated-tree",
    "exact-100644-blob-map",
    "git-blob-verification-before-json-parse",
    "git-blob-verification-before-local-activation",
    "exact-49-file-package-allowlist"
  ],
  "baseline": {
    "ravenVersion": "2.0.32",
    "commandCenterVersion": "2.1.0",
    "nodeAgentVersion": "1.3.0",
    "nodeActionsProtocol": "rah-node-actions-v7",
    "authProtocol": "rah-node-auth-v2",
    "policyId": "rah-capability-allowlist-v1"
  },
  "authoritySurface": {
    "capabilities": ["compute","storage","display","remote-desktop"],
    "actions": ["storage-summary.read","rustdesk.launch","rustdesk.connect"],
    "businessRoutes": ["/health","/actions","/storage","/launch/rustdesk","/handoff/rustdesk"]
  },
  "forbiddenExpansion": [
    "new-capability",
    "new-action",
    "new-business-route",
    "generic-command-process-action-file-api",
    "caller-controlled-executable-path-or-generic-arguments",
    "network-discovery",
    "background-polling",
    "native-raven-remote-control-api",
    "bearer-token-lan-transport",
    "secret-persistence"
  ]
}
