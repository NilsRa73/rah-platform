{
  "manifest_version": 3,
  "name": "RAH Chronicle",
  "version": "0.2.0",
  "description": "Privacy-first local work tracker and RAH daily/weekly report companion.",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": ["http://127.0.0.1:18766/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "RAH Chronicle" }
}
